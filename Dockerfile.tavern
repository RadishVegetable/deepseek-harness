FROM node:22-bookworm-slim

WORKDIR /app

ENV COREPACK_HOME=/corepack
ENV DSH_HOME=/data/.dsh
ENV DSH_WEB_HOST=0.0.0.0
ENV DSH_WEB_PORT=3080

COPY . .

RUN corepack enable \
  && corepack pnpm install --frozen-lockfile \
  && corepack pnpm run build

RUN mkdir -p /data/.dsh

EXPOSE 3080

CMD ["node", "apps/cli/lib/bin.js", "web", "--patch", "packages/bundle/tavern/cordis.patch.yml"]
